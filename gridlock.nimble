version     = "0.1.0"
author      = "daveey"
description = "Gridlock: four parcel fleets share one signalised 9x9 city. Score is your own deliveries — and the greedy route is the one that builds the jam everybody sits in. A congestion commons at real-time scale."
license     = "MIT"

srcDir = "src"

requires "nim >= 2.2.4"
requires "bitworld >= 0.1.0"
requires "mummy >= 0.4.7"
requires "curly >= 1.1.1"
requires "whisky"
